{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeviceFabric",
  "version": "0.1.0",
  "identifier": "app.dfabric.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeviceFabric",
        "width": 860,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    }
  }
}
